@inherits PaginationTable
@code{
    /// <summary>
    /// 使用场景：又想自动生成，又想过滤一些字段不显示
    /// 忽略字段-Address，Yes将不会显示在列表中
    /// </summary>
    string[] ignoreProps = { "Address","Yes"};
}
<ElTable IgnoreProperties=ignoreProps  DataSource="Datas" PageSize="pageSize" Total="AllDatas.Count" @bind-CurrentPage="CurrentPage" @ref="table">
    <ElTableColumns>
        <ElTableTemplateColumn Text="操作">
            <ElButton Type="@ButtonType.Primary" Size="@ButtonSize.Mini" OnClick="@(e=> Edit(context))">编辑</ElButton>
            <ElButton Type="@ButtonType.Danger" Size="@ButtonSize.Mini" OnClick="@(e=> Del(context))">删除</ElButton>
        </ElTableTemplateColumn>
    </ElTableColumns>
</ElTable>