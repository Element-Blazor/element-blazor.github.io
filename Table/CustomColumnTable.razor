@inherits BasicTable

<ElTable DataSource="Datas" AutoGenerateColumns="false">
    <ElTableColumns>
        <ElTableColumn Width="100" Property="@nameof(TestData.Name)" Text="姓名"></ElTableColumn>
        <ElTableDateTimeColumn Width="200" Format="yyyy-MM-dd" Property="@nameof(TestData.Time)" Text="时间"></ElTableDateTimeColumn>
        <ElTableColumn Width="300" Property="@nameof(TestData.Address)" Text="地址"></ElTableColumn>
        <ElTableTemplateColumn Text="操作">
            <ElButton Type="@ButtonType.Primary" Size="@ButtonSize.Mini" OnClick="@(e=> Edit(context))">编辑</ElButton>
            <ElButton Type="@ButtonType.Danger" Size="@ButtonSize.Mini" OnClick="@(e=> Del(context))">删除</ElButton>
        </ElTableTemplateColumn>
    </ElTableColumns>
</ElTable>