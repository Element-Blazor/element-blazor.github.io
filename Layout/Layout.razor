<ElLayout Height="500">
    <West>
        <ElCard Shadow="@ShadowShowType.Never">
            <Header>
                导航菜单
            </Header>
            <Body>
                <ElMenu Mode="@MenuMode.Vertical" DefaultActive="0">
                    <ElMenuItem Route="button">Button 按钮</ElMenuItem>
                    <ElMenuItem Route="input">Input 输入框</ElMenuItem>
                    <ElMenuItem Route="radio">Radio 单选框</ElMenuItem>
                    <ElMenuItem Route="checkbox">Checkbox 多选框</ElMenuItem>
                    <ElMenuItem Route="select">Select 选择器</ElMenuItem>
                    <ElMenuItem Route="switch">Switch</ElMenuItem>
                    <ElMenuItem Route="menu">NavMenu 导航菜单</ElMenuItem>
                    <ElMenuItem Route="tabs">Tabs 标签页</ElMenuItem>
                    <ElMenuItem Route="table">Table 表格</ElMenuItem>
                    <ElMenuItem Route="message">Message 消息</ElMenuItem>
                    <ElMenuItem Route="pagination">Pagination 分页</ElMenuItem>
                    <ElMenuItem Route="loading">Loading 加载中</ElMenuItem>
                    <ElMenuItem Route="messagebox">MessageBox 消息弹窗</ElMenuItem>
                    <ElMenuItem Route="dialog">Dialog 对话框</ElMenuItem>
                    <ElMenuItem Route="datepicker">DatePicker 日期选择器</ElMenuItem>
                    <ElMenuItem Route="form">Form 表单</ElMenuItem>
                    <ElMenuItem Route="layout">Layout 布局面板</ElMenuItem>
                </ElMenu>
            </Body>
        </ElCard>
    </West>
    <Center>
        <ElTabs Type="@TabType.Card">
            <ElTabPane Title="标签页1">
                标签页
            </ElTabPane>
        </ElTabs>
    </Center>
</ElLayout>