<ElContainer Style="height:280px;border:var(--el-border);">
    <ElAside Width="180px" Style="background:var(--el-fill-color-light);padding:16px;">Aside</ElAside>
    <ElContainer>
        <ElHeader Height="52px" Style="background:var(--el-color-success-light-9);display:flex;align-items:center;">Header</ElHeader>
        <ElMain>
            <ElSpace Direction="@SpaceDirection.Vertical" Alignment="@SpaceAlignment.Stretch" Style="width:100%;">
                <ElText Type="@TextType.Primary">Content A</ElText>
                <ElText Type="@TextType.Success">Content B</ElText>
            </ElSpace>
        </ElMain>
        <ElFooter Height="44px" Style="background:var(--el-fill-color-lighter);display:flex;align-items:center;">Footer</ElFooter>
    </ElContainer>
</ElContainer>
