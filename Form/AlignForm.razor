@inherits Element.Demo.Form.BasicForm

<ElRadioGroup TValue="LabelAlign" @bind-SelectedValue="formAlign">
    <ElRadioButton TValue="object" Model="LabelAlign.Left">左对�</ElRadioButton>
    <ElRadioButton TValue="object" Model="LabelAlign.Right">右对�</ElRadioButton>
    <ElRadioButton TValue="object" Model="LabelAlign.Top">顶部对齐</ElRadioButton>
</ElRadioGroup>
<br />
<ElForm Style="width:400px;" @ref="demoForm" LabelPosition="formAlign">
    <ElFormItem TValue="string" Label="活动名称" Prop="@nameof(Activity.Name)" Required="true">
        <ElInput TValue="string"></ElInput>
    </ElFormItem>
    <ElFormItem TValue="Area" Label="活动区域" Prop="@nameof(Activity.Area)" Required="true">
        <ElSelect TValue="Area" Placeholder="请选择活动区域">
        </ElSelect>
    </ElFormItem>
    <ElFormItem TValue="DateTime?" Label="活动时间" Required="true" Prop="@nameof(Activity.Time)">
        <ElDatePicker></ElDatePicker>
    </ElFormItem>
    <ElFormItem TValue="bool" Label="即时配�? Required="true" Prop="@nameof(Activity.Delivery)">
        <ElSwitch TValue="bool" ActiveValue="true" InactiveValue="false"></ElSwitch>
    </ElFormItem>
    <ElFormItem TValue="IEnumerable<string>" Label="活动性质" Required="true" Prop="@nameof(Activity.Type)">
        <ElCheckboxGroup TValue="string">
            <ElCheckbox TValue="object" Model="@("Online")">美食线上活动</ElCheckbox>
            <ElCheckbox TValue="object" Model="@("Offline")">地推活动</ElCheckbox>
        </ElCheckboxGroup>
    </ElFormItem>
    <ElFormItem TValue="string" Label="特殊资源" Required="true" Prop="@nameof(Activity.Resource)">
        <ElRadio TValue="object" Model="@("品牌")">线上品牌赞助</ElRadio>
        <ElRadio TValue="object" Model="@("场地")">线上场地免费</ElRadio>
    </ElFormItem>
    <ElFormItem TValue="string" Label="活动形式" Required="true" Prop="@nameof(Activity.Description)">
        <ElInput TValue="string" Type="@InputType.Textarea"></ElInput>
    </ElFormItem>
    <ElFormItem TValue="object">
        <ElButton Type="@ButtonType.Primary" OnClick="e=>Submit()">立即创建</ElButton>
        <ElButton OnClick="e=>Reset()">重置</ElButton>
    </ElFormItem>
</ElForm>