@using Element.Demo.Form
<ElForm Style="width:400px;" @ref="demoForm" Model="value">
    <ElFormItem TValue="string" Label="活动名称" Prop="@nameof(UploadActivity.Name)" Required="true">
        <ElInput TValue="string"></ElInput>
    </ElFormItem>
    <ElFormItem TValue="Area" Label="活动区域" Prop="@nameof(UploadActivity.Area)" Required="true">
        <ElSelect TValue="Area" Placeholder="请选择活动区域">
        </ElSelect>
    </ElFormItem>
    <ElFormItem TValue="IFileModel[]" Label="审批文件" Prop="@nameof(UploadActivity.Files)" Required="true">
        <ElUpload Url="/api/test/upload">
        </ElUpload>
    </ElFormItem>
    <ElFormItem TValue="IFileModel[]" Label="场景预览" Prop="@nameof(UploadActivity.Previews)">
        <ElUpload Url="/api/test/upload" UploadType="UploadType.Image">
        </ElUpload>
    </ElFormItem>
    <ElFormActionItem>
        <ElButton Type="@ButtonType.Primary" OnClick="e=>Submit()">立即创建</ElButton>
        <ElButton OnClick="e=>Reset()">重置</ElButton>
    </ElFormActionItem>
</ElForm>