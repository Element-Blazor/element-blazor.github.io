@inherits ElementComponentBase
<ElForm @ref="form" Model="article">
    <ElFormItem TValue="string" Label="标题" Required="true" Prop="@nameof(ArticleModel.Title)">
        <ElInput TValue="string"></ElInput>
    </ElFormItem>
    <ElFormItem TValue="string" Label="内容" Required="true" Prop="@nameof(ArticleModel.Content)">
        <ElMarkdownEditor UploadUrl="/api/md/upload" DisableFileUpload="true" DisableImageUpload="true"></ElMarkdownEditor>
    </ElFormItem>
    <ElFormActionItem Style="text-align:right">
        <ElButton Type="@ButtonType.Primary" OnClick="Submit">创建</ElButton>
    </ElFormActionItem>
</ElForm>